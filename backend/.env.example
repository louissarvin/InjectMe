# ============================================
# InjectMe Backend Configuration
# Copy to .env and fill in your values
# ============================================

# App
APP_PORT=3700
NODE_ENV=development
# CORS_ORIGINS=https://injectme.xyz,https://www.injectme.xyz  # Comma-separated, used in production

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:admin@localhost:5432/injectme?schema=public"

# Authentication
JWT_SECRET="your-jwt-secret-key-here"
JWT_EXPIRES_IN=7d

# ============================================
# 0G Chain (EVM)
# ============================================

# Testnet (default for development)
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602

# Mainnet (switch for final submission)
# OG_RPC_URL=https://evmrpc.0g.ai
# OG_CHAIN_ID=16661

# Deployed contract addresses (from forge script output)
FACTORY_ADDRESS=0x...
AGENT_NFT_ADDRESS=0x...
TEE_ORACLE_ADDRESS=0x...

# ============================================
# 0G Compute (Sealed Inference / TEE)
# ============================================

# Provider address from broker.inference.listService()
OG_COMPUTE_PROVIDER=0x...

# ============================================
# 0G Storage
# ============================================

# Testnet
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
OG_FLOW_CONTRACT=0x22E03a6A89B950F1c82ec5e74F8eCa321a105296

# Mainnet (uncomment for final submission)
# OG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
# OG_FLOW_CONTRACT=0x62D4144dB0F0a6fBBaeb6296c785C71B3D57C526

# KV stream ID (created on first write)
OG_KV_STREAM_ID=
OG_KV_NODE_URL=

# ============================================
# Wallets (private keys, KEEP SECRET)
# ============================================
ORACLE_PRIVATE_KEY=0x...
EVALUATOR_PRIVATE_KEY=0x...
STORAGE_PRIVATE_KEY=0x...

# ============================================
# Faucets (for testnet tokens)
# ============================================
# https://faucet.0g.ai (0.1 0G/day)
# https://cloud.google.com/application/web3/faucet/0g/galileo
