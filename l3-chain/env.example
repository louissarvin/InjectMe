# =============================================================================
# InjectMe L3 App-Chain Configuration
# =============================================================================
# Copy to .env and fill in values before deployment.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# L1 (0G Chain) Connection
# ---------------------------------------------------------------------------

# 0G Chain Galileo Testnet JSON-RPC endpoint.
# Use a dedicated node or third-party provider for production.
# Docs: https://docs.0g.ai/developer-hub/testnet/testnet-overview
L1_RPC_URL=https://evmrpc-testnet.0g.ai

# Provider type hint for op-node (basic, alchemy, quicknode, infura, parity,
# nethermind, debug_geth, erigon, any).
L1_RPC_KIND=basic

# 0G Chain Galileo Testnet chain ID.
L1_CHAIN_ID=16602

# ---------------------------------------------------------------------------
# L3 Chain Parameters
# ---------------------------------------------------------------------------

# Custom chain ID for the InjectMe L3 rollup.
L3_CHAIN_ID=16601

# Human-readable chain name (used in genesis and metadata).
L3_CHAIN_NAME=InjectMe-L3

# Target block time in seconds.
L3_BLOCK_TIME=2

# Gas limit per block (30 million).
L3_GAS_LIMIT=30000000

# ---------------------------------------------------------------------------
# Operator Accounts
# ---------------------------------------------------------------------------
# Each role requires a funded 0G Chain address. Fund via https://faucet.0g.ai
# Admin:     >= 0.5 0G  (contract upgrades)
# Batcher:   >= 0.1 0G  (posts DA commitments to L1)
# Proposer:  >= 0.2 0G  (posts state roots to L1)
# Sequencer: signing key only (no L1 balance needed)

GS_ADMIN_ADDRESS=
GS_ADMIN_PRIVATE_KEY=

GS_BATCHER_ADDRESS=
GS_BATCHER_PRIVATE_KEY=

GS_PROPOSER_ADDRESS=
GS_PROPOSER_PRIVATE_KEY=

GS_SEQUENCER_ADDRESS=
GS_SEQUENCER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# DA Server (0G DA sidecar)
# ---------------------------------------------------------------------------

# HTTP address the DA server listens on (op-node and op-batcher connect here).
DA_SERVER_URL=http://da-server:3100

# gRPC endpoint of the 0G DA client (disperser).
# If running the DA client locally, use localhost:51001.
# In Docker, use the service name: da-client:51001
DA_CLIENT_ENDPOINT=da-client:51001

# ---------------------------------------------------------------------------
# 0G DA Client Configuration
# ---------------------------------------------------------------------------

# gRPC port for the disperser server inside the DA client.
DA_CLIENT_GRPC_PORT=51001

# Blob expiration in seconds (default 30 days).
DA_BLOB_EXPIRY=2592000

# Private key for DA client chain interaction (hex-encoded, no 0x prefix).
DA_SIGNER_PRIVATE_KEY=

# DA encoder gRPC endpoint.
DA_ENCODER_ENDPOINT=da-encoder:34000

# ---------------------------------------------------------------------------
# 0G DA Smart Contracts (Galileo Testnet)
# ---------------------------------------------------------------------------

# DAEntrance contract on 0G Chain Galileo testnet.
DA_ENTRANCE_CONTRACT=0xE75A073dA5bb7b0eC622170Fd268f35E675a957B

# DASigners precompile (fixed address on all 0G chains).
DA_SIGNERS_CONTRACT=0x0000000000000000000000000000000000001000

# ---------------------------------------------------------------------------
# OP Stack Alt-DA Configuration
# ---------------------------------------------------------------------------

# Commitment type for Alt-DA (GenericCommitment for 0G DA).
DA_COMMITMENT_TYPE=GenericCommitment

# Challenge and resolve windows in L1 blocks.
DA_CHALLENGE_WINDOW=160
DA_RESOLVE_WINDOW=160

# ---------------------------------------------------------------------------
# OP Stack Component Ports
# ---------------------------------------------------------------------------

# op-geth JSON-RPC (L3 user-facing RPC).
OP_GETH_HTTP_PORT=8545

# op-geth WebSocket.
OP_GETH_WS_PORT=8546

# op-geth authenticated Engine API (internal, JWT-protected).
OP_GETH_AUTH_PORT=8551

# op-geth P2P port.
OP_GETH_P2P_PORT=30303

# op-node RPC port.
OP_NODE_RPC_PORT=9545

# op-node P2P port.
OP_NODE_P2P_PORT=9003

# ---------------------------------------------------------------------------
# Data Directories (host paths for Docker volumes)
# ---------------------------------------------------------------------------

# Persistent data directory for op-geth.
OP_GETH_DATA_DIR=./data/op-geth

# Persistent data directory for op-node.
OP_NODE_DATA_DIR=./data/op-node

# Persistent data directory for DA client.
DA_CLIENT_DATA_DIR=./data/da-client

# ---------------------------------------------------------------------------
# Monitoring (optional)
# ---------------------------------------------------------------------------

# Enable Prometheus metrics on OP Stack components.
METRICS_ENABLED=true

# Prometheus scrape port for op-geth.
OP_GETH_METRICS_PORT=6060

# Prometheus scrape port for op-node.
OP_NODE_METRICS_PORT=7300

# Prometheus scrape port for op-batcher.
OP_BATCHER_METRICS_PORT=7301

# Prometheus scrape port for op-proposer.
OP_PROPOSER_METRICS_PORT=7302

# ---------------------------------------------------------------------------
# L1 Contract Addresses (populated by deploy script)
# ---------------------------------------------------------------------------

# These are set after running scripts/deploy-l3.sh.
# Do NOT fill manually unless reusing an existing deployment.

L2OO_ADDRESS=
L1_STANDARD_BRIDGE_PROXY=
L1_CROSS_DOMAIN_MESSENGER_PROXY=
DISPUTE_GAME_FACTORY_PROXY=
